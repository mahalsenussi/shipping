                            <td><input type="number" step="0.001" name="cargo_items[<?php echo $j; ?>][volume_cbm]" class="form-control" value="<?php echo htmlspecialchars($it['volume_cbm'] ?? ''); ?>"></td>
                            <td><input type="text" name="cargo_items[<?php echo $j; ?>][container_number_ref]" class="form-control" placeholder="رقم الحاوية إن وجد"></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="fas fa-trash"></i></button></td>
                        </tr>
                        <?php $j++; endforeach; ?>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">يمكنك إضافة/حذف/تعديل بيانات البضائع.</div>
    </div>

    <div class="text-end mt-3">
        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
    </div>
</form>

<script>
// Toggle shipping fields based on shipping type
function toggleShippingFields(shippingType) {
    const navalFields = document.querySelectorAll('#naval-fields');
    if (shippingType === 'naval') {
        navalFields.forEach(field => field.style.display = 'block');
    } else {
        navalFields.forEach(field => field.style.display = 'none');
    }
}

function addContainerRow() {
    const tbody = document.querySelector('#containersTable tbody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td><input type="text" name="containers[${containerIndex}][container_number]" class="form-control" placeholder="مثال: ABCD1234567"></td>
        <td>
            <select name="containers[${containerIndex}][container_type_id]" class="form-select">
                <option value="">-- اختر --</option>
                <?php foreach ($containerTypes as $t): ?>
                <option value="<?php echo $t['id']; ?>"><?php echo htmlspecialchars($t['code'] . (!empty($t['description'])?' - '.$t['description']:'')); ?></option>
                <?php endforeach; ?>
            </select>
        </td>
        <td><input type="text" name="containers[${containerIndex}][seal_number]" class="form-control" placeholder="ختم"></td>
        <td><input type="number" step="0.01" name="containers[${containerIndex}][weight_kg]" class="form-control" placeholder="0.00"></td>
        <td><input type="number" step="0.001" name="containers[${containerIndex}][volume_cbm]" class="form-control" placeholder="0.000"></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="fas fa-trash"></i></button></td>
    `;
    tbody.appendChild(tr);
    containerIndex++;
}

let cargoIndex = <?php echo isset($j)? (int)$j : 0; ?>;
function addCargoRow() {
    const tbody = document.querySelector('#cargoTable tbody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td><input type="text" name="cargo_items[${cargoIndex}][description]" class="form-control" required></td>
        <td><input type="text" name="cargo_items[${cargoIndex}][hs_code]" class="form-control"></td>
        <td style="max-width:110px"><input type="number" min="1" step="1" name="cargo_items[${cargoIndex}][quantity]" class="form-control" value="1" required></td>
        <td style="max-width:140px">
            <select name="cargo_items[${cargoIndex}][unit_type]" class="form-select">
                <option value="PCS">PCS</option>
                <option value="CTN">CTN</option>
                <option value="PKG">PKG</option>
            </select>
        </td>
        <td><input type="number" step="0.01" name="cargo_items[${cargoIndex}][weight_kg]" class="form-control"></td>
        <td><input type="number" step="0.001" name="cargo_items[${cargoIndex}][volume_cbm]" class="form-control"></td>
        <td><input type="text" name="cargo_items[${cargoIndex}][container_number_ref]" class="form-control" placeholder="رقم الحاوية إن وجد"></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="fas fa-trash"></i></button></td>
    `;
    tbody.appendChild(tr);
    cargoIndex++;
}
</script>
