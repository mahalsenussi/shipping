                            <td style="max-width:110px"><input type="number" min="1" step="1" name="cargo_items[<?php echo $j; ?>][quantity]" class="form-control" value="<?php echo (int)$it['quantity']; ?>" required></td>
                            <td style="max-width:140px">
                                <select name="cargo_items[<?php echo $j; ?>][unit_type]" class="form-select">
                                    <?php $units=['PCS','CTN','PKG']; foreach ($units as $u): ?>
                                        <option value="<?php echo $u; ?>" <?php echo ($it['unit_type']===$u?'selected':''); ?>><?php echo $u; ?></option>
                                    <?php endforeach; ?>
                                </select>
