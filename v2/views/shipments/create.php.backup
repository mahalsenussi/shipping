<script>
// Toggle shipping fields based on shipping type
function toggleShippingFields(shippingType) {
    const navalFields = document.querySelectorAll('#naval-fields');
    if (shippingType === 'naval') {
        navalFields.forEach(field => field.style.display = 'block');
    } else {
        navalFields.forEach(field => field.style.display = 'none');
    }
}

// Initialize form on page load
document.addEventListener('DOMContentLoaded', function() {
    const shippingTypeSelect = document.querySelector('select[name="shipping_type"]');
    if (shippingTypeSelect && shippingTypeSelect.value) {
        toggleShippingFields(shippingTypeSelect.value);
    }
});
</script>

let containerIndex = 0;
function addContainerRow() {
    const tbody = document.querySelector('#containersTable tbody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td><input type="text" name="containers[${containerIndex}][container_number]" class="form-control" placeholder="مثال: ABCD1234567" required></td>
        <td>
            <select name="containers[${containerIndex}][container_type_id]" class="form-select" required>
                <option value="">-- اختر النوع --</option>
                ${containerTypesOptions()}
            </select>
        </td>
        <td><input type="text" name="containers[${containerIndex}][seal_number]" class="form-control" placeholder="رقم الختم"></td>
        <td><input type="number" step="0.01" name="containers[${containerIndex}][weight_kg]" class="form-control" placeholder="0.00"></td>
        <td><input type="number" step="0.001" name="containers[${containerIndex}][volume_cbm]" class="form-control" placeholder="0.000"></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="fas fa-trash"></i></button></td>
    `;
    tbody.appendChild(tr);
    containerIndex++;
}

function escapeHtml(text) {
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return String(text).replace(/[&<>"']/g, m => map[m]);
}

function containerTypesOptions() {
    const types = <?php echo json_encode($containerTypes); ?>;
    return types.map(t => `<option value="${t.id}">${escapeHtml(t.code)}${t.description ? ' - ' + escapeHtml(t.description) : ''}</option>`).join('');
}
function addCargoRow() {
    const tbody = document.querySelector('#cargoTable tbody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td><input type="text" name="cargo_items[${cargoIndex}][description]" class="form-control" required placeholder="وصف البضاعة"></td>
        <td><input type="text" name="cargo_items[${cargoIndex}][hs_code]" class="form-control" placeholder="HS Code"></td>
        <td style="max-width:110px"><input type="number" min="1" step="1" name="cargo_items[${cargoIndex}][quantity]" class="form-control" value="1" required placeholder="الكمية"></td>
        <td style="max-width:140px">
            <select name="cargo_items[${cargoIndex}][unit_type]" class="form-select">
                <option value="PCS">قطعة</option>
                <option value="CTN">كرتونة</option>
                <option value="PKG">طرد</option>
            </select>
        </td>
        <td><input type="number" step="0.01" name="cargo_items[${cargoIndex}][weight_kg]" class="form-control" placeholder="الوزن (كجم)"></td>
        <td><input type="number" step="0.001" name="cargo_items[${cargoIndex}][volume_cbm]" class="form-control" placeholder="الحجم (CBM)"></td>
        <td><input type="text" name="cargo_items[${cargoIndex}][container_number_ref]" class="form-control" placeholder="رقم الحاوية إن وجد"></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="fas fa-trash"></i></button></td>
    `;
    tbody.appendChild(tr);
    cargoIndex++;
}

function escapeHtml(text) {
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return String(text).replace(/[&<>"']/g, m => map[m]);
}
</script>

